# ==============================================================================
# Frame by Frame: Animation Idea Generator - Environment Configuration
# ==============================================================================

# NVIDIA AI Provider Settings
# Obtain an API key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA Base URL (Default is NVIDIA NIM API Catalog)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Model Identifier
# Examples:
# - meta/llama-3.1-70b-instruct
# - meta/llama-3.1-8b-instruct
# - mistralai/mixtral-8x22b-instruct
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# HTTP Client Timeouts & Retries
NVIDIA_TIMEOUT_SECONDS=45.0
NVIDIA_MAX_RETRIES=2

# Application Settings
APP_HOST=127.0.0.1
APP_PORT=8000
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=10
